# Cloudflare Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Lakehouse Target (the Gantry factory writes task telemetry into this bucket too)
R2_BUCKET_NAME=gantry

# Public demo bucket (gantry-demo): token scoped to that bucket only, Object Read & Write
DEMO_R2_ACCESS_KEY_ID=your_demo_r2_access_key_id
DEMO_R2_SECRET_ACCESS_KEY=your_demo_r2_secret_access_key
